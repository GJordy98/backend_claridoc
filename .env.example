# ==========================================================================
#  ClariDoc Pro — backend Django
#  MODELE. Copier en `.env` et renseigner les valeurs reelles.
#  Le fichier `.env` est ignore par git : il ne doit JAMAIS etre versionne.
# ==========================================================================

# --- BASE DE DONNEES (PostgreSQL) -----------------------------------------
DB_NAME=claridoc_pro_V2
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Alternative : une URL unique qui prend le pas sur les cinq cles ci-dessus
# DATABASE_URL=postgres://user:motdepasse@hote:5432/base

# --- DJANGO ---------------------------------------------------------------
# En production : generer une cle forte et mettre DEBUG=False
SECRET_KEY=
DEBUG=True

# --- EXPOSITION RESEAU ----------------------------------------------------
# Local : '*' par defaut. Production : lister les domaines.
# ALLOWED_HOSTS=api.mondomaine.com
# CSRF_TRUSTED_ORIGINS=https://app.mondomaine.com,https://api.mondomaine.com
# USE_HTTPS=1

# --- CORS -----------------------------------------------------------------
# Local : CORS_ALLOW_ALL=1. Production : 0 + liste explicite.
# CORS_ALLOW_ALL=0
# CORS_ALLOWED_ORIGINS=https://app.mondomaine.com
# CORS_ALLOW_CREDENTIALS=0

# --- SMTP (Brevo) ---------------------------------------------------------
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
BREVO_API_KEY=

# --- HUB DE PAIEMENT STEEVE ----------------------------------------------
STEEVE_HUB_TOKEN=
STEEVE_HUB_WEBHOOK_SECRET=
STEEVE_HUB_BASE_URL=

# --- FRONTEND -------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# --- CAPTCHA (Cloudflare Turnstile) --------------------------------------
# Valeur ci-dessous = cle de TEST publique, toujours valide.
# La remplacer par la vraie cle secrete en production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
